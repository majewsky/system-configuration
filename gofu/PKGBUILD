# novendor

pkgname=gofu
epoch=2
pkgver=2026.3
pkgrel=1
pkgdesc='Collection of Go utilities'
arch=('x86_64')
url="https://git.xyrillian.de/gofu"
license=('GPL-3.0-only')
depends=()
makedepends=('go')
source=("${url}/snapshot/gofu-${pkgver}.tar.gz")
sha256sums=('fbe752a536bd6a6fe5a5c3f08485f2bf9e53f49f9db3dace72e5c85e2b8e1445')

build() {
  cd "${srcdir}/gofu-${pkgver}"
  make
}

package() {
  cd "${srcdir}/gofu-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
