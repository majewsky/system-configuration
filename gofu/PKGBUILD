# novendor

pkgname=gofu
epoch=2
pkgver=2026.2
pkgrel=1
pkgdesc='Collection of Go utilities'
arch=('x86_64')
url="https://git.xyrillian.de/gofu"
license=('GPL-3.0-only')
depends=()
makedepends=('go')
source=("${url}/snapshot/gofu-${pkgver}.tar.gz")
sha256sums=('bcb9b91ba4da7fd44cb742478600235e443241e098a8440a4ffec062cd1cead8')

build() {
  cd "${srcdir}/gofu-${pkgver}"
  make
}

package() {
  cd "${srcdir}/gofu-${pkgver}"
  make install DESTDIR="${pkgdir}"
}
